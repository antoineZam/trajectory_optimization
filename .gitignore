# =============================================================================
# Trajectory Optimization - Data & outputs
# =============================================================================

# Hydra run outputs (generated on every run)
trajopt/outputs/

# Trained trajectories and data arrays
*.npy
*.npz

# Keep the sample track, ignore any other generated tracks
trajopt/data/tracks/*.json
!trajopt/data/tracks/sample_track.json

# Telemetry (generated during training)
trajopt/telemetry/*.json
trajopt/telemetry/*.csv

# Trained models
trajopt/models/saved/

# TensorBoard logs
trajopt/runs/
tb_logs/

